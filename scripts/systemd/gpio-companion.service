[Unit]
Description=gpio-companion device config API
After=network-online.target bluetooth.service gpio-companion-ble-adapter.service
Wants=network-online.target bluetooth.service gpio-companion-ble-adapter.service

[Service]
Type=simple
User=__GPIO_USER__
Group=__GPIO_USER__
SupplementaryGroups=gpio
ExecStart=/usr/local/bin/gpio-companion serve
Restart=always
RestartSec=3
TimeoutStopSec=15
KillMode=mixed
EnvironmentFile=-/etc/gpio-companion/update.env
EnvironmentFile=-/etc/gpio-companion/pairing.env
Environment=GPIO_USER=__GPIO_USER__
Environment=GPIO_COMPANION_CONFIG=/etc/gpio-companion/config.json
Environment=GPIO_COMPANION_TUNNEL_ENV=/etc/gpio-companion/cloudflared.env
Environment=GPIO_COMPANION_SECRETS=/etc/gpio-companion/secrets.env
Environment=GPIO_COMPANION_PAIRING=/etc/gpio-companion/pairing.json
Environment=GPIO_COMPANION_OPENCODE_SERVER_ENV=/etc/gpio-companion/opencode-server.env
Environment=GPIO_COMPANION_OPENCODE_URL=http://127.0.0.1:4096
Environment=GPIO_COMPANION_PORT=4150
Environment=GPIO_COMPANION_HARDWARE=raspberrypi
Environment=GPIO_COMPANION_DASHBOARD_URL=https://gpio-companion.com
Environment=GPIO_COMPANION_BLE_SCRIPT=/usr/local/lib/gpio-companion/ble-gatt-server.py

[Install]
WantedBy=multi-user.target
