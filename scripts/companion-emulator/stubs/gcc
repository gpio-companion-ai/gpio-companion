#!/bin/sh
. "${GPIO_EMU_STUBS}/_common.sh"
out=""
while [ "$#" -gt 0 ]; do
	if [ "$1" = "-o" ]; then
		shift
		out="$1"
	fi
	shift
done
if [ -z "$out" ]; then
	exit 1
fi
cat >"$out" <<EOF
#!/bin/sh
. "\${GPIO_EMU_STUBS}/_common.sh"
if [ -n "\$GPIO_HOST_STATUS" ]; then
	mkdir -p "\$(dirname "\$GPIO_HOST_STATUS")"
	printf '%s\n' "{\"pid\":\$\$,\"pins\":[{\"physical\":11,\"chip\":\"gpiochip0\",\"line\":17,\"mode\":\"out\",\"value\":1},{\"physical\":13,\"chip\":\"gpiochip0\",\"line\":27,\"mode\":\"out\",\"analog\":100}]}" >"\$GPIO_HOST_STATUS" 2>/dev/null || true
fi
emu_hold "sketch"
EOF
chmod +x "$out"
exit 0
