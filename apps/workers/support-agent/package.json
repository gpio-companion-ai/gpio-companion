{
	"name": "gpio-companion-support",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"packageManager": "bun@1.4.0",
	"description": "gpio-companion bug-report Pi harness",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"ci:install": "bun install --cwd ../../..",
