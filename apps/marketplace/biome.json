{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": ["src/**", "frame-master.config.ts", "newUI/**"]
	},
	"linter": {
		"rules": {
			"complexity": {
				"noArguments": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["newUI/**/*.html"],
			"linter": {
				"rules": {
					"correctness": {
						"noInvalidGridAreas": "off"
					},
					"style": {
						"noDescendingSpecificity": "off"
					},
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		}
	]
}
