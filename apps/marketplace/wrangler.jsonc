{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "gpio-companion-marketplace",
	"pages_build_output_dir": ".frame-master/build",
	"compatibility_date": "2026-02-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"BUN_VERSION": "1.4.2",
		"SKIP_DEPENDENCY_INSTALL": "true",
		"PUBLIC_AUTH_CLIENT_ID": "__gpio_companion_927ffcf9",
		"PUBLIC_AUTH_ISSUER": "https://c138e26ec90148fd88735d42f445004c-auth.webcreas.com",
		"PUBLIC_AUTH_REDIRECT_URI": "https://marketplace.gpio-companion.com/callback",
		"PAYPAL_ENV": "sandbox",
		"PUBLIC_PAYPAL_CLIENT_ID": "BAABxmBqK6EERDGyRgTKlhLfu_RX3xOfuSJJj1i4QcrdUgfe4MR_LgAVC59uVJonileGPQJk0RLwkoGPbc"
		// AUTH_SECRET Pages secret
		// PAYPAL_CLIENT_SECRET Pages secret
		// EASYSHIP_API_TOKEN Pages secret (prod_* or sand_ prefix; sand_ uses the sandbox API)
		// EASYSHIP_ORIGIN_LINE1 / LINE2 / CITY / REGION / POSTAL_CODE / COUNTRY (vars or Pages secrets)
		//   — seller ship-from address; LINE1, CITY, REGION, POSTAL_CODE, COUNTRY are required
		// EASYSHIP_ORIGIN_CONTACT_NAME / CONTACT_EMAIL / CONTACT_PHONE (optional)
		// EASYSHIP_ITEM_CATEGORY (optional, default "electronics" — must be an EasyShip item category slug)
	},
	"kv_namespaces": [
		{
			"binding": "DYNAMIC_PAGE_KV",
			"id": "15c5167369a74c7eac772c9432e82922"
		}
	],
	"d1_databases": [
		{
			"binding": "MARKETPLACE_DB",
			"database_name": "marketplace-db",
			"database_id": "2a46331a-11e3-483d-a2f2-7a80a0455dbc",
			"migrations_dir": "drizzle",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "MARKETPLACE_MEDIA",
			"bucket_name": "gpio-companion-marketplace-media",
			"remote": true
		}
	]
}