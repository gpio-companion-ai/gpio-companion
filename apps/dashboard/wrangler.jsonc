{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "gpio-companion-dashboard",
	"pages_build_output_dir": ".frame-master/build",
	"compatibility_date": "2026-02-17",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"BUN_VERSION": "1.4.2",
		"SKIP_DEPENDENCY_INSTALL": "true",
		"PUBLIC_AUTH_CLIENT_ID": "__gpio_companion_927ffcf9",
		"PUBLIC_AUTH_ISSUER": "https://c138e26ec90148fd88735d42f445004c-auth.webcreas.com",
		"PUBLIC_AUTH_REDIRECT_URI": "https://gpio-companion.com/callback",
		"GITHUB_APP_ID": "4778170",
		"GITHUB_APP_SLUG": "gpio-companion",
		"GITHUB_APP_CLIENT_ID": "Iv23licCRxaLNGii4SDj",
		"GPIO_AI_MARKUP": "1.25",
		"PAYPAL_ENV": "live",
		"PUBLIC_PAYPAL_CLIENT_ID": "BAABxmBqK6EERDGyRgTKlhLfu_RX3xOfuSJJj1i4QcrdUgfe4MR_LgAVC59uVJonileGPQJk0RLwkoGPbc",
		"JLCPCB_APP_ID": "626910717980270593",
		"CLOUDFLARE_ACCOUNT_ID": "17b0a92da13df078f38bcd297ee71f81"
	},
	"d1_databases": [
		{
			"binding": "DASHBOARD_DB",
			"database_name": "gpio-companion-dashboard",
			"database_id": "c1ffbccb-de80-4f65-bd69-516f508f64fe",
			"migrations_dir": "drizzle",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "DYNAMIC_PAGE_KV",
			"id": "91a78de240bc421187afe64a498d0014",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	// GPIO_COMPANION_DEVICE_PRIVATE_KEY Pages secret (Ed25519 PEM)
	// PAYPAL_CLIENT_SECRET Pages secret
	// PUBLIC_PAYPAL_CLIENT_ID wrangler var (do not bake empty)
	// JLCPCB_APP_ID Pages secret
	// JLCPCB_ACCESS_KEY Pages secret
	// JLCPCB_SECRET_KEY Pages secret
	// CLOUDFLARE_EMAIL_API_TOKEN Pages secret (Email Sending: Edit)
	// CLOUDFLARE_ACCOUNT_ID wrangler var (do not bake empty)
	"durable_objects": {
		"bindings": [
		{
			"name": "DEVICE_HUB",
			"class_name": "DeviceHub",
			"script_name": "gpio-companion-hub"
		},
		{
			"name": "SUPPORT_AGENT",
			"class_name": "SupportAgent",
			"script_name": "gpio-companion-support"
		}
		]
	}
}
