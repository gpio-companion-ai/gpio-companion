WRANGLER_PORT=8787
PUBLIC_AUTH_CLIENT_ID=__gpio_companion__
PUBLIC_AUTH_ISSUER=https://auth.example.com
PUBLIC_AUTH_REDIRECT_URI=http://localhost:3000/callback
# Native public client (apps/mobile): gpio-companion://auth/callback on the OpenAuthster project
# Native public client (apps/desktop): gpio-companion-desktop://auth/callback on the same client
AUTH_SECRET=
GPIO_COMPANION_DEVICE_PRIVATE_KEY=
GPIO_COMPANION_DEVICE_KEY_ID=gpio-companion-v1
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=/app/<slug>
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GPIO_AI_MARKUP=1.25
# PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox # Change to "live" for production

# JLCPCB credentials for accessing the JLCPCB API
JLCPCB_APP_ID=
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=
