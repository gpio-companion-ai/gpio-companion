{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@images/*": ["./images/*"],
			"@static/*": ["./static/*"],
			"@api/*": ["./src/actions/api/*"],
			"@components/*": ["./src/components/*"],
			"@docs/*": ["../../documentation/*"],
			"@skills/*": ["../../opencode/skills/*"],
			"@next/ssr": [
				"./node_modules/frame-master-plugin-cloudflare-pages-dynamic-ssr/src/server/index.ts"
			],
			"@next/ssr/revalidate": [
				"./node_modules/frame-master-plugin-cloudflare-pages-dynamic-ssr/src/utils/revalidate.ts"
			],
			"@next/ssr/hooks": [
				"./node_modules/frame-master-plugin-cloudflare-pages-dynamic-ssr/src/client/hooks.ts"
			],
			"@next/action/context": [
				"./node_modules/frame-master-plugin-cloudflare-pages-functions-action/src/context.ts"
			],
			"@next/client": ["./types/next-client.d.ts"],
			"gpio-companion-i18n": ["../../packages/core/src/i18n/index.ts"],
			"@hooks/*": ["./src/hooks/*"],
			"@next/hooks/path": ["./src/hooks/usePath.ts"],
			"openauthster-shared/client/user": ["./types/openauthster-user.d.ts"]
		}
	},
	"exclude": [
		"**/node_modules",
		"./src/auth.ts",
		"./src/lib/auth/**",
		"./src/hooks/useAuth.ts",
		"./src/pages/login.tsx",
		"./src/pages/callback.tsx",
		"./src/pages/pair.tsx",
		"./src/components/PairForm.tsx",
		"./src/components/Onboarding.tsx",
		"./src/components/LoginPanel.tsx",
		"./src/pages/index.tsx",
		"./src/actions/api/pair.ts",
		"./src/actions/api/t3.ts",
		"./src/actions/api/device.ts",
		"./src/lib/session.ts",
		"./src/components/KeysForm.tsx",
		"./src/pages/keys.tsx",
		"./src/pages/credits.tsx",
		"./src/actions/api/credits.ts",
		"./src/actions/api/ai/v1/chat/completions.ts",
		"./src/lib/credits.ts",
		"./src/actions/api/wifi.ts",
		"./src/actions/api/admin/devices.ts",
		"./src/components/WifiBleForm.tsx",
		"./src/pages/wifi.tsx",
		"./src/lib/web-bluetooth.ts",
		"./src/actions/api/notifications.ts",
		"./src/components/NotificationCenter.tsx",
		"./src/pages/notifications.tsx"
	]
}
