{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"baseUrl": ".",
		"paths": {
			"gpio-companion": ["../../packages/core/src/breadboard-view.ts"],
			"gpio-companion-ui": ["../../packages/core/src/ui.ts"],
			"gpio-companion-i18n": ["../../packages/core/src/i18n/index.ts"],
			"gpio-companion-wifi": ["../../packages/core/src/wifi.ts"],
			"gpio-companion-pairing": ["../../packages/core/src/pairing.ts"],
			"gpio-companion-opencode": [
				"../../packages/core/src/opencode-session.ts"
			],
			"gpio-companion-files": ["../../packages/core/src/board-files.ts"],
			"gpio-companion-sketches": ["../../packages/core/src/sketches.ts"],
			"gpio-companion-attach": ["../../packages/core/src/code-attach.ts"],
			"gpio-companion-jlcpcb": ["../../packages/core/src/jlcpcb-parts.ts"],
			"gpio-companion-usage": ["../../packages/core/src/usage-charts.ts"]
		}
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
