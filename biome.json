{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/out",
			"!**/tmp",
			"!**/worker-configuration.d.ts",
			"!**/.wrangler",
			"!**/apps/mobile/android",
			"!**/apps/mobile/ios",
			"!**/apps/mobile/.expo",
			"!**/.frame-master",
			"!**/apps/desktop/src-tauri/target",
			"!**/apps/desktop/src-tauri/gen",
			"!**/apps/desktop/dist",
			"!**/*.glb",
			"!**/*.stl",
			"!**/static/style.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["**/static/tailwind.css", "**/src/index.css"],
			"linter": {
				"rules": {
					"style": {
						"noDescendingSpecificity": "off"
					},
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
